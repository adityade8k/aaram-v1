HOST=127.0.0.1
PORT=4173
# Required on a hosted server. Enter this study access code in the research desk.
STUDY_ACCESS_TOKEN=
# Comma-separated exact browser origins for a separately hosted phone UI.
ALLOWED_ORIGINS=
# Same service and voice as the robot. An optional HF token stays on the server.
HF_TOKEN=
HF_REALTIME_WS_URL=
HF_HARDWARE_ID=
HF_VOICE=Aiden
REALTIME_TRANSCRIPTION_LANGUAGE=en
# Required only for background mode. Copy the actual deployed model ID from your robot setup.
ANTHROPIC_API_KEY=
REACHY_MINI_REASONING_MODEL=
REACHY_MINI_REASONING_EFFORT=medium
# Same raw web search service in BOTH modes.
BRAVE_SEARCH_API_KEY=
